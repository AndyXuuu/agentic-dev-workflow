{
  "agent": {
    "build": {
      "permission": {
        "task": {
          "frontend-*": "allow"
        }
      },
      "options": {
        "store": false
      }
    },
    "plan": {
      "permission": {
        "task": {
          "frontend-*": "allow"
        }
      },
      "options": {
        "store": false
      }
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "markdown": {
      "command": [
        "marksman"
      ],
      "extensions": [
        ".md",
        ".mdx"
      ]
    },
    "yaml-ls": {}
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "oh-my-opencode@3.16.0"
  ]
}
