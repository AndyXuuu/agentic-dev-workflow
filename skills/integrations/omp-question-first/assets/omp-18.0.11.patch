diff --git a/packages/coding-agent/src/tools/paused-tool-policy.ts b/packages/coding-agent/src/tools/paused-tool-policy.ts
new file mode 100644
index 0000000..7b4acd7
--- /dev/null
+++ b/packages/coding-agent/src/tools/paused-tool-policy.ts
@@ -0,0 +1,30 @@
+import type { ToolTier } from "@oh-my-pi/pi-agent-core";
+
+const QUESTION_PAUSE_READ_TOOLS: Record<string, true> = {
+	ast_grep: true,
+	github: true,
+	glob: true,
+	grep: true,
+	inspect_image: true,
+	lsp: true,
+	read: true,
+	recall: true,
+	security_scan: true,
+	think: true,
+	web_search: true,
+};
+
+/**
+ * Whether a model-issued tool call is observational enough to run while the
+ * current user turn has paused execution. The approval tier remains necessary
+ * for argument-dependent tools such as GitHub and LSP; the name allowlist
+ * excludes tools that declare read tier despite changing session state.
+ */
+export function toolAllowedWhileQuestionPaused(
+	toolName: string,
+	tier: ToolTier,
+	args: Record<string, unknown>,
+): boolean {
+	if (toolName === "todo") return args.op === "view";
+	return tier === "read" && QUESTION_PAUSE_READ_TOOLS[toolName] === true;
+}
diff --git a/packages/coding-agent/test/agent-session-question-first.test.ts b/packages/coding-agent/test/agent-session-question-first.test.ts
new file mode 100644
index 0000000..c47f4ea
--- /dev/null
+++ b/packages/coding-agent/test/agent-session-question-first.test.ts
@@ -0,0 +1,147 @@
+import { afterAll, afterEach, describe, expect, it, vi } from "bun:test";
+import * as path from "node:path";
+import { type } from "@oh-my-pi/omptype";
+import { Agent, type AgentTool, type AgentToolContext } from "@oh-my-pi/pi-agent-core";
+import { createMockModel, type MockResponse } from "@oh-my-pi/pi-ai/providers/mock";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import type { ExtensionRunner } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/runner";
+import { ExtensionToolWrapper } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/wrapper";
+import { AgentSession, type AgentSessionEvent } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { classifyUserPrompt } from "@oh-my-pi/pi-coding-agent/session/conversation-control";
+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const mutateSchema = type({ value: type("string") });
+const sharedDir = TempDir.createSync("@pi-question-first-shared-");
+const sharedAuthStorage = await AuthStorage.create(path.join(sharedDir.path(), "auth.db"));
+sharedAuthStorage.setRuntimeApiKey("mock", "test-key");
+const sharedModelRegistry = new ModelRegistry(sharedAuthStorage, path.join(sharedDir.path(), "models.yml"));
+const activeSessions: Array<{ session: AgentSession; tempDir: TempDir }> = [];
+
+function toolCall(id: string): MockResponse {
+	return {
+		content: [{ type: "toolCall", id, name: "mutate", arguments: { value: id } }],
+		stopReason: "toolUse",
+	};
+}
+
+async function createHarness(responses: MockResponse[]) {
+	const tempDir = TempDir.createSync("@pi-question-first-");
+	const mock = createMockModel({ responses });
+	sharedAuthStorage.setRuntimeApiKey(mock.provider, "test-key");
+	let mutations = 0;
+	const mutateTool: AgentTool<typeof mutateSchema> = {
+		name: "mutate",
+		label: "Mutate",
+		description: "Change observable state",
+		parameters: mutateSchema,
+		approval: "write",
+		async execute(_toolCallId, params) {
+			mutations++;
+			return { content: [{ type: "text", text: `mutated:${params.value}` }] };
+		},
+	};
+	const agent = new Agent({
+		getApiKey: () => "test-key",
+		initialState: { model: mock, systemPrompt: ["Test"], tools: [mutateTool], messages: [] },
+		convertToLlm,
+		streamFn: mock.stream,
+	});
+	const session = new AgentSession({
+		agent,
+		sessionManager: SessionManager.inMemory(tempDir.path()),
+		settings: Settings.isolated({
+			"compaction.enabled": false,
+			"retry.enabled": false,
+			"conversation.questionFirst": true,
+			"todo.enabled": true,
+			"todo.reminders": true,
+		}),
+		modelRegistry: sharedModelRegistry,
+		toolRegistry: new Map([[mutateTool.name, mutateTool]]),
+	});
+	activeSessions.push({ session, tempDir });
+	return { session, mutateTool, mutationCount: () => mutations };
+}
+
+afterEach(async () => {
+	vi.restoreAllMocks();
+	for (const harness of activeSessions.splice(0)) {
+		await harness.session.dispose();
+		harness.tempDir.removeSync();
+	}
+});
+
+afterAll(() => {
+	sharedAuthStorage.close();
+	sharedDir.removeSync();
+});
+
+describe("question-first conversation gate", () => {
+	it("classifies direct Chinese analysis requests without punctuation", () => {
+		expect(classifyUserPrompt("你不分析一下我说的对不对吗")).toBe("question");
+		expect(classifyUserPrompt("需要注意几点，任务不能扩展 Spec")).toBe("question");
+		expect(classifyUserPrompt("按这个方案继续修改")).toBe("execution");
+		expect(classifyUserPrompt("先改 OMP runtime")).toBe("execution");
+	});
+
+	it("answers a question without mutation or todo continuation, then resumes explicitly", async () => {
+		const harness = await createHarness([
+			toolCall("blocked"),
+			{ content: ["先回答问题。"], stopReason: "stop" },
+			toolCall("allowed"),
+			{ content: ["执行完成。"], stopReason: "stop" },
+		]);
+		const reminders: number[] = [];
+		harness.session.subscribe((event: AgentSessionEvent) => {
+			if (event.type === "todo_reminder") reminders.push(event.attempt);
+		});
+		harness.session.setTodoPhases([
+			{ name: "Implementation", tasks: [{ content: "Apply change", status: "in_progress" }] },
+		]);
+
+		await harness.session.prompt("你不分析一下我说的对不对吗");
+
+		expect(harness.session.executionPausedForUser).toBe(true);
+		expect(harness.mutationCount()).toBe(0);
+		expect(reminders).toEqual([]);
+
+		harness.session.setTodoPhases([]);
+		await harness.session.prompt("继续执行");
+
+		expect(harness.session.executionPausedForUser).toBe(false);
+		expect(harness.mutationCount()).toBe(1);
+	});
+
+	it("blocks direct wrapped write tools outside the normal agent loop", async () => {
+		let executed = false;
+		const tool: AgentTool<typeof mutateSchema> = {
+			name: "mutate",
+			label: "Mutate",
+			description: "Change observable state",
+			parameters: mutateSchema,
+			approval: "write",
+			async execute() {
+				executed = true;
+				return { content: [{ type: "text", text: "mutated" }] };
+			},
+		};
+		const runner = {
+			consumeToolCallEmitted: () => false,
+			hasHandlers: () => false,
+		} as unknown as ExtensionRunner;
+		const wrapped = new ExtensionToolWrapper(tool, runner);
+		const context = {
+			executionPausedForUser: true,
+			settings: Settings.isolated({ "tools.approvalMode": "yolo" }),
+		} as AgentToolContext;
+
+		await expect(wrapped.execute("direct-write", { value: "x" }, undefined, undefined, context)).rejects.toThrow(
+			"Execution is paused for the current user question",
+		);
+		expect(executed).toBe(false);
+	});
+});
