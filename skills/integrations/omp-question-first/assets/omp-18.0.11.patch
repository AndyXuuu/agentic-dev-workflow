diff --git a/packages/coding-agent/src/session/conversation-control.ts b/packages/coding-agent/src/session/conversation-control.ts
new file mode 100644
index 0000000..aa232a5
--- /dev/null
+++ b/packages/coding-agent/src/session/conversation-control.ts
@@ -0,0 +1,36 @@
+/**
+ * Deterministic user-message classification for the optional question-first gate.
+ *
+ * This is deliberately a conservative lexical boundary: a trailing question mark,
+ * an explicit question opener, or a direct request for analysis/clarification pauses
+ * autonomous tool work. Ambiguous statements remain executable so the feature does
+ * not turn ordinary task prompts into a confirmation ceremony.
+ */
+
+export type UserPromptIntent = "question" | "execution";
+
+const ENGLISH_QUESTION_START_RE =
+	/^(?:what|which|when|where|why|how|who|whom|whose|do|does|did|can|could|would|will|should|is|are|am|may|shall)\b/i;
+const CJK_QUESTION_START_RE =
+	/^(?:为什么|为何|怎么|如何|什么|哪个|哪些|哪里|何时|谁|是否|能否|能不能|可以吗|可不可以|是不是|要不要|需不需要|有没有|怎么回事|什么情况)/u;
+const DISCUSSION_CUE_RE =
+	/(?:分析一下|请分析|帮我分析|判断一下|请判断|评估一下|请评估|对不对|为什么可以|为什么没有|什么情况|解释一下|先回答|不要继续|暂停执行|只回答|有什么问题|有问题吗|需要注意|注意几点|这些约束|这个流程设计|我认为|我觉得|建议先)/u;
+const QUESTION_SUFFIX_RE = /(?:[?？]|吗|呢|么|嘛)\s*$/u;
+
+/** Classify a user prompt without invoking a model or reading project state. */
+export function classifyUserPrompt(text: string): UserPromptIntent {
+	const normalized = text.trim();
+	if (!normalized) return "execution";
+	if (QUESTION_SUFFIX_RE.test(normalized)) return "question";
+	if (ENGLISH_QUESTION_START_RE.test(normalized) || CJK_QUESTION_START_RE.test(normalized)) return "question";
+	if (DISCUSSION_CUE_RE.test(normalized)) return "question";
+	return "execution";
+}
+
+/** Explicit resume phrases clear a previous question pause. */
+export function isExplicitResumePrompt(text: string): boolean {
+	const normalized = text.trim().toLowerCase();
+	return /^(?:(?:请|先|现在)?(?:继续(?:执行|处理|修改)?|恢复执行|执行|实施|落地|改|修改|修复|新增|删除|创建|运行|更新)|按这个方案(?:继续|执行|修改)?|resume|continue|proceed|implement|apply|execute)(?:\s|$|[，,。.!！])/u.test(
+		normalized,
+	);
+}
