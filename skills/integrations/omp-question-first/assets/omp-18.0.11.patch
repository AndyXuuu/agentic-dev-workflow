+import { describe, expect, it } from "bun:test";
+import { classifyUserPrompt, isExplicitResumePrompt } from "@oh-my-pi/pi-coding-agent/session/conversation-control";
+import { toolAllowedWhileQuestionPaused } from "@oh-my-pi/pi-coding-agent/tools/paused-tool-policy";
+
+describe("question-first prompt classification", () => {
+	it("pauses direct questions, analysis requests, and design-constraint discussions", () => {
+		expect(classifyUserPrompt("这个流程设计层面能改吗")).toBe("question");
+		expect(classifyUserPrompt("你不分析一下我说的对不对吗")).toBe("question");
+		expect(classifyUserPrompt("需要注意几点，任务不能扩展 Spec")).toBe("question");
+	});
+
+	it("keeps explicit implementation requests executable", () => {
+		expect(classifyUserPrompt("先改 OMP runtime")).toBe("execution");
+		expect(isExplicitResumePrompt("继续执行")).toBe(true);
+		expect(isExplicitResumePrompt("按这个方案修改")).toBe(true);
+		expect(isExplicitResumePrompt("继续吗？")).toBe(false);
+	});
+});
+
+describe("question-first tool policy", () => {
+	it("allows observational reads and todo view only", () => {
+		expect(toolAllowedWhileQuestionPaused("read", "read", {})).toBe(true);
+		expect(toolAllowedWhileQuestionPaused("lsp", "read", { action: "diagnostics" })).toBe(true);
+		expect(toolAllowedWhileQuestionPaused("todo", "read", { op: "view" })).toBe(true);
+		expect(toolAllowedWhileQuestionPaused("todo", "read", { op: "done" })).toBe(false);
+	});
+
+	it("blocks writes, execution, delegation, and stateful read-tier tools", () => {
+		expect(toolAllowedWhileQuestionPaused("write", "read", { path: "xd://lsp" })).toBe(false);
+		expect(toolAllowedWhileQuestionPaused("edit", "write", {})).toBe(false);
+		expect(toolAllowedWhileQuestionPaused("bash", "exec", {})).toBe(false);
+		expect(toolAllowedWhileQuestionPaused("task", "exec", {})).toBe(false);
+		expect(toolAllowedWhileQuestionPaused("hub", "read", { op: "send" })).toBe(false);
+	});
+});
